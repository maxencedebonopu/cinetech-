# Port HTTP du serveur (API + interface)
PORT=8765

# Clé TMDB : « clé API » v3 (32 caractères) ou « jeton d'accès en lecture » v4 (commence par eyJ)
TMDB_KEY=

# Mot de passe de l'accès distant (Tailscale, réseau local). Plutôt à définir dans Réglages,
# où il est enregistré haché ; celui-ci ne sert que si aucun n'y est défini.
MOT_DE_PASSE=

# Facultatif : contact (e-mail ou URL) envoyé à Wikipédia, qui sert les fiches tant qu'il n'y a pas
# de clé TMDB. Sans contact, Wikimédia limite à 10 requêtes/min (≈ 40 s par film) ; avec, bien plus vite.
WIKI_CONTACT=

# Langue des métadonnées TMDB
TMDB_LANGUAGE=fr-FR

# Dossiers de films au premier lancement (séparés par ;). Modifiables ensuite dans Réglages.
LIBRARY_DIRS=C:\DOCUMENTS\Movies & Shows

# Dossier des données (base SQLite, images en cache, fichiers temporaires)
DATA_DIR=./data

# Facultatif : chemins explicites vers ffmpeg / ffprobe (sinon détection automatique)
FFMPEG_PATH=
FFPROBE_PATH=
