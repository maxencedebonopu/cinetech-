# Port HTTP du serveur (API + interface)
PORT=8765

# Clé TMDB : « clé API » v3 (32 caractères) ou « jeton d'accès en lecture » v4 (commence par eyJ)
TMDB_KEY=

# Langue des métadonnées TMDB
TMDB_LANGUAGE=fr-FR

# Dossiers de films au premier lancement (séparés par ;). Modifiables ensuite dans Réglages.
LIBRARY_DIRS=C:\DOCUMENTS\Movies & Shows

# Dossier des données (base SQLite, images en cache, fichiers temporaires)
DATA_DIR=./data

# Facultatif : chemins explicites vers ffmpeg / ffprobe (sinon détection automatique)
FFMPEG_PATH=
FFPROBE_PATH=
